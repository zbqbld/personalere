{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ziwei-doushu",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // D1 已创建并建表（accounts / sessions / profiles）。
  // AI 密钥需在 Worker 首次部署后配置：npx wrangler secret put DEEPSEEK_API_KEY
  // Worker 创建之前执行 secret put 会报 "Worker not found"。
  "d1_databases": [
    {
      "binding": "ZIWEI_DB",
      "database_name": "ziwei-doushu",
      "database_id": "0996c53e-a5d0-4ecd-bbae-3968a0a67904"
    }
  ],
  // NEXT_PUBLIC_* 变量在 next build 时会被内联；正式站点请在构建命令里注入真实域名。
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://REPLACE_WITH_YOUR_DOMAIN"
  },
  "observability": {
    "enabled": true
  }
}
