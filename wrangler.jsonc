{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ziwei-doushu",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // D1 已创建并建表（accounts / sessions / profiles）。
  "d1_databases": [
    {
      "binding": "ZIWEI_DB",
      "database_name": "ziwei-doushu",
      "database_id": "0996c53e-a5d0-4ecd-bbae-3968a0a67904"
    }
  ],
  // 线上 AI 配置全部放在 Worker secret 里（密钥不进仓库、也不走 vars）：
  //   npx wrangler secret put MIMO_API_KEY          # 智谱 key（id.secret 格式）
  //   npx wrangler secret put MIMO_BASE_URL        # https://open.bigmodel.cn/api/paas/v4
  //   npx wrangler secret put MIMO_MODEL           # glm-5.3-flash
  //   npx wrangler secret put MIMO_REASONING_EFFORT # low | high | max
  // 注意：同一个名字不能既是 secret 又是 vars 绑定，否则 deploy 会报绑定冲突。
  // Worker 创建之前执行 secret put 会报 "Worker not found"。
  "d1_databases": [
    {
      "binding": "ZIWEI_DB",
      "database_name": "ziwei-doushu",
      "database_id": "0996c53e-a5d0-4ecd-bbae-3968a0a67904"
    }
  ],
  // NEXT_PUBLIC_* 变量在 next build 时会被内联；正式站点请在构建命令里注入真实域名。
  "vars": {
    // 国内可直连的正式访问地址（Cloudflare Pages 反向代理 → Workers），见 cloudflare-proxy/
    "NEXT_PUBLIC_SITE_URL": "https://ziwei-doushu-8uh.pages.dev"
  },
  "observability": {
    "enabled": true
  }
}
